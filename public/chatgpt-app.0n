[deployment_gate]
; ALL must be true before app submission:
gate_01 = Supabase migration run — 4 tables verified
gate_02 = RSA key pair generated and set in Vercel
gate_03 = All 14 files placed at correct paths
gate_04 = Next.js rewrites added for .well-known/* routes
gate_05 = All 3 .well-known endpoints return 200
gate_06 = MCP endpoint returns 401 without Bearer token
gate_07 = OAuth flow completes end-to-end in ChatGPT Developer Mode
gate_08 = All 5 tools return structuredContent + widget renders
gate_09 = No platform brand names in any file
;          grep -r "GoHighLevel\|HighLevel\|GHL\b\|ghl\." --include="*.ts" --include="*.tsx" --include="*.html" .

