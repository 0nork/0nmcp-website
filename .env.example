# ============================================================
# Add0n — Rocket+CRM powered by 0nMCP
# marketplace.rocketclients.com + 0nmcp.com
# ============================================================
# Copy to .env.local for local dev.
# Set all vars in Vercel → Project Settings → Environment Variables.
# Vercel project: prj_Ccq53WXdb5CQd4iIBRR0qr4QToge
# ============================================================

# ── CRM Developer App ────────────────────────────────────────────────────────
# From: CRM Developer Portal → My Apps → Client Credentials

CRM_APP_CLIENT_ID=
CRM_APP_CLIENT_SECRET=           # Shown ONCE at creation — copy immediately

# Exact redirect URI registered in the CRM Developer Portal
CRM_OAUTH_REDIRECT_URI=https://marketplace.rocketclients.com/api/crm/oauth/callback

# App's unique ID (visible in the app URL in Developer Portal)
CRM_APP_ID=

# Webhook signing secret — CRM Developer Portal → My Apps → Webhooks
CRM_WEBHOOK_SIGNING_SECRET=

# SSO key — CRM Developer Portal → My Apps → SSO (for iframe custom menu)
CRM_APP_SSO_KEY=

# ── Token Encryption ─────────────────────────────────────────────────────────
# Encrypts access_token + refresh_token before Supabase writes.
# Generate: openssl rand -hex 32
# Rotating this key requires re-encrypting all existing crm_tokens rows.

CRM_TOKEN_ENCRYPTION_KEY=        # 64-char hex string

# ── CRM Location (own 0n sub-location) ───────────────────────────────────────
# Used as fallback when no per-location OAuth token exists (internal/dev builds).

CRM_LOCATION_ID=
CRM_API_KEY=                     # Location-scoped private integration token
CRM_AGENCY_KEY=                  # Agency key for sub-location provisioning
CRM_AGENT_USER_ID=               # User ID for posting agent notes
CRM_WEBSITE_BUILDER_AGENT_ID=    # Agent Studio agent ID (from agent URL)

# ── 0nMCP Internal Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32

WEB0N_INTERNAL_API_KEY=          # Bearer token for dashboard → trigger route
WEB0N_WEBHOOK_SECRET=            # Shared secret for CRM automation → trigger

# ── Supabase ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://pwujhhmlrtxjmjzyttwn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # Never expose client-side

# ── Domains ──────────────────────────────────────────────────────────────────

NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.rocketclients.com
NEXT_PUBLIC_WEB0N_API_BASE=https://0nmcp.com

# ── Stripe ───────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# web0n Site Builder listing
STRIPE_WEB0N_PRODUCT_ID=prod_UA5cvUVlD9QKIi
STRIPE_WEB0N_PRICE_ID=price_1TBlRrHThmAuKVQMeswwujpo

# ── AI Providers ─────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Pipeline / Workflow IDs ───────────────────────────────────────────────────
# Set these after creating the web0n pipeline in the CRM platform.

WEB0N_PIPELINE_ID=
WEB0N_STAGE_IN_BUILD_ID=
WEB0N_STAGE_COMPLETE_ID=

# ── Figma OAuth (OnPress) ──────────────────────────────────────────────────
# Register at https://www.figma.com/developers/apps
# App name: 0nMCP | Redirect URI: https://0nmcp.com/api/figma/oauth/callback

FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=https://0nmcp.com/api/figma/oauth/callback
