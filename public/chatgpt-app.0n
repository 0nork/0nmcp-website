file_09 = app/api/chatgpt/oauth/token/route.ts                       ; EXTRACT from chatgpt/oauth/route.ts POST_token()
file_10 = app/api/chatgpt/oauth/revoke/route.ts                      ; NEW — spec in Build Guide Step 5
