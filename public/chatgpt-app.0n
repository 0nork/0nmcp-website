file_13 = supabase/migrations/20260316_chatgpt_oauth.sql             ; ✓ provided — PASTE IN SUPABASE
file_14 = package.json                                               ; ✓ provided — merge deps into existing

[supabase_tables]
; Run 20260316_chatgpt_oauth.sql — verify these 4 tables exist:
table_01 = chatgpt_oauth_clients   ; DCR registrations
table_02 = chatgpt_auth_requests   ; auth code flow state
table_03 = chatgpt_refresh_tokens  ; issued refresh tokens
table_04 = chatgpt_tool_calls      ; analytics + billing log

[well_known_endpoints]
; Verify these all return 200 after deployment:
oauth_protected_resource   = https://0nmcp.com/.well-known/oauth-protected-resource
oauth_authorization_server = https://0nmcp.com/.well-known/oauth-authorization-server
jwks                       = https://0nmcp.com/.well-known/jwks.json

[mcp_tools_exposed]
; Tools registered in apps-sdk/server/index.ts:
tool_01 = build_website     ; Trigger website build. Cost: 1 Spark.
tool_02 = browse_tools      ; Browse 800+ tool catalog. Cost: 0 Sparks.
tool_03 = run_pipeline      ; Execute any 0nMCP pipeline. Cost: 1-5 Sparks.
tool_04 = get_account       ; Load user account + Sparks balance. Cost: 0 Sparks.
tool_05 = purchase_sparks   ; External checkout → 0nmcp.com/sparks. Cost: 0 Sparks.

