[chatgpt_oauth_keys]
; Status: GENERATE — do this in Step 2 of the build guide
; Run these commands in sequence:

key_generation_step_1 = openssl genrsa -out /tmp/chatgpt_oauth_private.pem 2048
key_generation_step_2 = openssl rsa -in /tmp/chatgpt_oauth_private.pem -pubout -out /tmp/chatgpt_oauth_public.pem
key_generation_step_3 = awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/chatgpt_oauth_private.pem
key_generation_step_4 = awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/chatgpt_oauth_public.pem

; Set these in Vercel after running the commands:
CHATGPT_OAUTH_PRIVATE_KEY = [GENERATE: output of step 3 above]
CHATGPT_OAUTH_PUBLIC_KEY  = [GENERATE: output of step 4 above]
CHATGPT_OAUTH_KEY_ID      = 0nmcp-chatgpt-2026

[env_vars_vercel]
; CONFIRMED values — already set from Add0n build. Verify, do not overwrite.
NEXT_PUBLIC_WEB0N_API_BASE   = https://0nmcp.com                         ; [EXISTS]
NEXT_PUBLIC_SUPABASE_URL     = https://pwujhhmlrtxjmjzyttwn.supabase.co  ; [EXISTS]
SUPABASE_SERVICE_ROLE_KEY    = [EXISTS — Supabase → Settings → API → service_role]
WEB0N_INTERNAL_API_KEY       = [EXISTS — from Add0n build]
ANTHROPIC_API_KEY            = [EXISTS — from Anthropic console]
OPENAI_API_KEY               = [EXISTS]

; NEW — required for this build only:
CHATGPT_OAUTH_PRIVATE_KEY    = [GENERATE: see chatgpt_oauth_keys section]
CHATGPT_OAUTH_PUBLIC_KEY     = [GENERATE: see chatgpt_oauth_keys section]
CHATGPT_OAUTH_KEY_ID         = 0nmcp-chatgpt-2026

